# 1. Ocultar el listado de archivos en directorios
Options -Indexes

# 2. Definir codificación de caracteres por defecto
AddDefaultCharset UTF-8

# Páginas personalizadas de errores (rutas relativas a la raíz)
ErrorDocument 403 /app/views/errors/error.php?codigo=403
ErrorDocument 404 /app/views/errors/error.php?codigo=404
ErrorDocument 429 /app/views/errors/error.php?codigo=429
ErrorDocument 500 /app/views/errors/error.php?codigo=500
ErrorDocument 502 /app/views/errors/error.php?codigo=502
ErrorDocument 504 /app/views/errors/error.php?codigo=504


# 3. Configuración de URLs Amigables
<IfModule mod_rewrite.c>
# Activar el motor de reescritura de URLs
RewriteEngine On

# Establecer la ruta base dinámica para la raíz
RewriteBase /

# Regla de excepción 1: No redirigir si la petición corresponde a un archivo real
RewriteCond %{REQUEST_FILENAME} !-f

# Regla de excepción 2: No redirigir si la petición corresponde a una carpeta real
RewriteCond %{REQUEST_FILENAME} !-d

# Reescribir cualquier ruta al archivo index.php
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>